@@ -9,6 +9,15 @@ import datetime
 import subprocess
 from PIL import Image, ImageDraw, ImageFont
 
+# Force UTF-8 stdout regardless of the OS default console codepage. Several
+# simulations print names/status text containing non-ASCII characters (e.g.
+# "Rössler Attractor"), which crashes on Windows' default cp1252 console
+# encoding rather than only ever running under a UTF-8-default environment —
+# confirmed as a real failure on Windows during verification.
+if hasattr(sys.stdout, "reconfigure"):
+    sys.stdout.reconfigure(encoding="utf-8", errors="replace")
+    sys.stderr.reconfigure(encoding="utf-8", errors="replace")
+
 # Add current directory to path so imports work correctly
 sys.path.append(os.path.dirname(os.path.abspath(__file__)))
 
