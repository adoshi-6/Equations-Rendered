{
  "name": "Equations Rendered - Queue Check + Notify",
  "nodes": [
    {
      "parameters": {},
      "id": "manual-trigger-1",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-100, 300]
    },
    {
      "parameters": {
        "content": "## Setup notes\n1. Set your Google Sheets document (spreadsheet ID) on both Google Sheets nodes below.\n2. Set your Telegram credential + chat ID (8988190596) on the Telegram node.\n3. This workflow checks the Queue tab for a pending item, and only pings Telegram about an empty queue ONCE per exhaustion (no repeat spam).\n4. Wire the 'Queue Has Item' TRUE branch into your actual render-trigger logic (POST /jobs/render on render_service.py).",
        "height": 260,
        "width": 380
      },
      "id": "sticky-1",
      "name": "Setup Notes",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [-100, -60]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Queue",
          "mode": "name"
        },
        "filtersUI": {
          "values": [
            {
              "lookupColumn": "status",
              "lookupValue": "pending"
            }
          ]
        },
        "options": {
          "returnAllMatches": false
        }
      },
      "id": "read-queue-1",
      "name": "Read Next Pending Queue Item",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [140, 300],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.id }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-queue-has-item",
      "name": "Queue Has Item?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [380, 300]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "queue_empty_notified": false
          },
          "matchingColumns": []
        },
        "options": {}
      },
      "id": "reset-flag",
      "name": "Reset queue_empty_notified = FALSE",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [640, 180],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "content": "Wire this branch onward to:\n1. Mark the Queue row 'in_progress'\n2. POST /jobs/render on render_service.py\n(continue building Phase C from here)",
        "height": 140,
        "width": 300
      },
      "id": "sticky-2",
      "name": "Continue Render Flow Here",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [860, 100]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "options": {}
      },
      "id": "read-settings",
      "name": "Read Settings Flag",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [640, 420],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-2",
              "leftValue": "={{ $json.queue_empty_notified }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-already-notified",
      "name": "Already Notified?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [880, 420]
    },
    {
      "parameters": {
        "chatId": "8988190596",
        "text": "⚠️ Equations Rendered: the render queue is empty. Add more items to the Queue tab to resume uploads.",
        "additionalFields": {}
      },
      "id": "telegram-notify",
      "name": "Send Telegram: Queue Empty",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1120, 500],
      "credentials": {
        "telegramApi": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Telegram account"
        }
      }
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "value": "REPLACE_WITH_YOUR_SHEET_ID",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Settings",
          "mode": "name"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "queue_empty_notified": true
          },
          "matchingColumns": []
        },
        "options": {}
      },
      "id": "set-flag-true",
      "name": "Set queue_empty_notified = TRUE",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [1360, 500],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_WITH_YOUR_CREDENTIAL_ID",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {},
